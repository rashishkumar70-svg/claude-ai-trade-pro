# ⚠️ TEMPLATE ONLY — do NOT put real values in this file in GitHub.
# Streamlit Cloud: paste into your app → Settings → Secrets and fill in values THERE.
# PC engine: save a copy as .streamlit/secrets.toml (git-ignored) and fill in values.

[upstox]
atok = "PASTE_YOUR_UPSTOX_ANALYTICS_TOKEN_HERE"
aexp = "2027-11-25"          # token expiry date (YYYY-MM-DD)

[telegram]
token = "PASTE_YOUR_NEW_BOT_TOKEN_FROM_BOTFATHER"
chat = "CHAT_ID_1,CHAT_ID_2"  # comma-separated chat IDs
